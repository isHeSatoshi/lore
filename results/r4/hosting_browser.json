          "sql": "-- Your SQL query\nWITH conn_atoms AS (\n    SELECT atom_id AS aid FROM connected\n    UNION\n    SELECT atom_id2 AS aid FROM connected\n),\nbonded_counts AS (\n    SELECT a.element AS element, COUNT(*) AS n\n    FROM atom a\n    JOIN conn_atoms ca ON a.atom_id = ca.aid\n    JOIN molecule m ON a.molecule_id = m.molecule_id\n    WHERE m.label = '+'\n    GROUP BY a.element\n),\ntop_elements AS (\n    SELECT element FROM bonded_counts\n    WHERE n = (SELECT MAX(n) FROM bonded_counts)\n),\nall_atoms AS (\n    SELECT a.element AS element, COUNT(*) AS n\n    FROM atom a\n    JOIN molecule m ON a.molecule_id = m.molecule_id\n    WHERE m.label = '+'\n    GROUP BY a.element\n),\ndenominator AS (\n    SELECT COUNT(*) AS total\n    FROM atom a\n    JOIN molecule m ON a.molecule_id = m.molecule_id\n    WHERE m.label = '+'\n)\nSELECT t.element AS element,\n       ROUND(CAST(COALESCE(aa.n, 0) AS REAL) * 100 / d.total, 2) AS percentage\nFROM top_elements t\nCROSS JOIN denominator d\nLEFT JOIN all_atoms aa ON aa.element = t.element\nORDER BY percentage DESC, t.element",
